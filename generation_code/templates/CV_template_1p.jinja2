\BLOCK{include 'cv_preamble.jinja2'}
\BLOCK{import 'cv_entries.jinja2' as e with context}
%% CV_template_1p.jinja2 -- the short CV (--onepager).
%%
%% Same macros and the same yaml as the full CV; it just shows fewer sections and
%% only the publications flagged `onepager` in publications.yaml. It used to carry
%% its own hardcoded Positions, Education and Area Chair blocks, which had gone
%% stale (it still said Assistant Professor and listed a hand-written 2025 slate).

\begin{document}
\maketitle

\section{Positions}
\BLOCK{for p in positions['current']}
\VAR{e.position(p)}
\BLOCK{endfor}

\section{Education}
\BLOCK{for d in education}
\VAR{e.degree(d)}
\BLOCK{endfor}

\section{Publications}
\BLOCK{for pub_type in pub_types}
\BLOCK{for entry in publications[pub_type]}
\VAR{e.publication(entry)}
\BLOCK{endfor}
\BLOCK{endfor}

%% Only the two most recent years of area-chair service; the full CV lists all of
%% it. The hand-written block this replaced showed a single year's slate.
\section{(Senior) Area Chair / Action Editor}
\BLOCK{for year, areas in (areachair.items()|list)[:2]}
\BLOCK{for area, roles in areas.items()}
\BLOCK{set area_loop = loop}
\BLOCK{for role, conferences in roles.items()}
\BLOCK{set role_loop = loop}
\BLOCK{for conference in conferences}
\VAR{e.areachair_row(year if area_loop.first and role_loop.first and loop.first else '--', role, conference, area)}
\BLOCK{endfor}
\BLOCK{endfor}
\BLOCK{endfor}
\BLOCK{endfor}

\end{document}
