\BLOCK{include 'cv_preamble.jinja2'}
\BLOCK{import 'cv_entries.jinja2' as e with context}
%% CV_template.jinja2 -- layout only.
%%
%% Every entry is a semantic macro from cvlayout.sty taking named keys; every
%% value comes from yaml/. Nothing here hardcodes content, and nothing here
%% hardcodes a width -- see cv_entries.jinja2 for the shared entry macros and
%% cvlayout.sty for the column widths, which are derived from \maincolumnwidth.

%----------------------------------------------------------------------------------
%            content
%----------------------------------------------------------------------------------
\begin{document}
\maketitle

\section{Positions}
\BLOCK{for p in positions['current']}
\VAR{e.position(p)}
\BLOCK{endfor}
\subsection{Previous}
\BLOCK{for p in positions['previous']}
\VAR{e.position(p)}
\BLOCK{endfor}

\section{Education}
\BLOCK{for d in education}
\VAR{e.degree(d)}
\BLOCK{endfor}

\section{Postdocs \hfill \href{https://talkingtorobots.com}{TalkingToRobots.com}}
\BLOCK{for entry in postdocs}
\VAR{e.person(entry, role='Post', when=entry['start'] ~ ' --')}
\BLOCK{endfor}

\section{PhD Students}
\BLOCK{for entry in students}
\VAR{e.person(entry, role='PhD', when=entry['start'] ~ ' --')}
\BLOCK{endfor}

\section{Masters}
\BLOCK{for entry in masters}
\VAR{e.person(entry)}
\BLOCK{endfor}

\section{Alumni}
\subsection{PhD}
\BLOCK{for entry in alumni_phd}
\cvalumnusphd{%
  dept={\VAR{entry.get('dept') or ''}},
  name={\VAR{entry['name']}},
  url={\VAR{(entry.get('url') or '')|url}},
  co={\VAR{entry.get('co') or ''}},
  courl={\VAR{(entry.get('co_url') or '')|url}},
  when={\VAR{entry['start']}-\VAR{entry['year']}},
  thesis={\VAR{entry['thesis']|tex}}}
\BLOCK{endfor}

\subsection{MS}
\BLOCK{for entry in alumni if entry['role'] not in e.intern_roles}
\VAR{e.person(entry)}
\BLOCK{endfor}

\subsection{Interns and Undergraduates}
\BLOCK{for entry in alumni if entry['role'] in e.intern_roles}
\VAR{e.person(entry)}
\BLOCK{endfor}

\subsection{Capstones}
\BLOCK{for c in capstones}
\cvcapstone{%
  program={\VAR{c['program']|prose}},
  project={\VAR{c['project']|prose}},
  url={\VAR{(c.get('url') or '')|url}},
  co={\VAR{(c.get('co') or '')|prose}},
  courl={\VAR{(c.get('courl') or '')|url}},
  when={\VAR{c['when']}}}
\BLOCK{if c['members']}
\begin{cvroster}{\VAR{c['columns']}}
\BLOCK{for row in c['members']|batch(c['columns'])}
\BLOCK{for m in row}\cvmember{\VAR{(m.get('url') or '')|url}}{\VAR{m['name']|prose}}{\VAR{m.get('pron') or ''}}\BLOCK{if not loop.last} & \BLOCK{endif}\BLOCK{endfor}\BLOCK{if not loop.last} \\\BLOCK{endif}
\BLOCK{endfor}
\end{cvroster}
\BLOCK{endif}
\BLOCK{endfor}

\BLOCK{for pub_type in pub_types}
\section{\VAR{pub_type} Publications}
\BLOCK{for entry in publications[pub_type]}
\VAR{e.publication(entry)}
\BLOCK{endfor}
\BLOCK{endfor}

\section{Thesis Committees}
\BLOCK{for year, types in theses.items()}
\BLOCK{for type, students in types.items()}
\BLOCK{for student, properties in students.items()}
\cvcommittee{%
  when={\VAR{year}},
  kind={\VAR{type}},
  student={\VAR{student}},
  url={\VAR{(properties.get('url') or '')|url}},
  advisor={\VAR{properties.get('adv') or ''}},
  uni={\VAR{properties.get('uni') or ''}}}
\BLOCK{endfor}
\BLOCK{endfor}
\BLOCK{endfor}

\section{Teaching}
\BLOCK{for year, semesters in teaching.items()}
\BLOCK{for semester, entries in semesters.items()}
\BLOCK{set year_loop = loop}
\BLOCK{for entry in entries}
\cvteaching{%
  when={\VAR{year if year_loop.first and loop.first else '--'}},
  course={\VAR{entry['class']}},
  co={\VAR{entry.get('CO') or entry.get('co') or ''}},
  size={\VAR{entry.get('size') or ''}},
  term={\VAR{semester}}}
\BLOCK{endfor}
\BLOCK{endfor}
\BLOCK{endfor}

\section{(Senior) Area Chair / Action Editor}
\BLOCK{for year, areas in areachair.items()}
\BLOCK{for area, roles in areas.items()}
\BLOCK{set year_loop = loop}
\BLOCK{for role, conferences in roles.items()}
\BLOCK{set area_loop = loop}
\BLOCK{for conference in conferences}
\VAR{e.areachair_row(year if year_loop.first and area_loop.first and loop.first else '--', role, conference, area)}
\BLOCK{endfor}
\BLOCK{endfor}
\BLOCK{endfor}
\BLOCK{endfor}

\section{Reviewer}
\BLOCK{for area, venues in reviewing.items()}
\BLOCK{for v in venues}
\cvreviewing{%
  area={\VAR{area|prose if loop.first else ''}},
  acronym={\VAR{v['acronym']|prose}},
  venue={\VAR{v['venue']|prose}},
  years={\VAR{v['years']|prose}}}
\BLOCK{endfor}
\BLOCK{endfor}

\section{Organization (Workshops and Conference)}
\BLOCK{for year, roles in organization.items()}
\BLOCK{for r in roles}
\cvorganizing{%
  when={\VAR{year if loop.first else '--'}},
  kind={\VAR{r['kind']|prose}},
  what={\VAR{r['what']|prose}},
  url={\VAR{(r.get('url') or '')|url}},
  venue={\VAR{(r.get('venue') or '')|prose}}}
\BLOCK{endfor}
\BLOCK{endfor}

\section{Invitations and Talks}
\BLOCK{for year, entries in talks.items()}
\BLOCK{for t in entries}
\cvtalkentry{%
  when={\VAR{year if loop.first else ''}},
  title={\VAR{(t.get('title') or '')|prose}},
  url={\VAR{(t.get('url') or '')|url}},
  venue={\VAR{(t.get('venue') or '')|prose}},
  venueurl={\VAR{(t.get('venueurl') or '')|url}},
  host={\VAR{(t.get('host') or '')|prose}}}
\BLOCK{endfor}
\BLOCK{endfor}

%% Department/University Service -- kept off the public CV. The record lives in
%% yaml/service.yaml; change `false` to `true` below to print it.
\BLOCK{if false}
\section{Department/University Service}
\BLOCK{for year, items in service.items()}
\BLOCK{for s in items}
\cvservice{%
  when={\VAR{year if loop.first else '--'}},
  what={\VAR{s['what']|prose}},
  detail={\VAR{(s.get('detail') or '')|prose}}}
\BLOCK{endfor}
\BLOCK{endfor}
\BLOCK{endif}

\end{document}
